# Copy this to .env and set the real backend URL once Ayush's FastAPI
# service is deployed. Falls back to mock data automatically if this
# isn't set or the backend isn't reachable.
VITE_BACKEND_URL=http://localhost:8000

# Ayush's backend requires this header (X-API-Key) on /incidents and
# /responders once auth is enforced there (see his RESPONDER_API_KEY /
# ADMIN_API_KEY setup). Without this set, requests still go out, but a
# secured backend will reject them with 401 and this dashboard will
# silently fall back to mock data — it'll *look* broken with no obvious
# error in the UI, so if incidents aren't loading and the backend is
# confirmed running, check this first.
VITE_API_KEY=
