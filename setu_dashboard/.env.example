# Dashboard build configuration. EVERYTHING prefixed VITE_ is compiled into public JavaScript:
# NEVER put a secret here. In particular there is no responder key/token variable any more --
# operators sign in with their key at runtime (POST /auth/responder-login) and get a short-lived
# session token.

# REQUIRED for a production build: the https:// origin of the deployed backend. It must also
# appear in vercel.json's Content-Security-Policy connect-src (a mismatch is blocked by the browser).
VITE_BACKEND_URL=

# Optional and OFF by default. VITE_DEMO_MODE=true builds an explicit demo: sample data, no
# backend calls, a permanent "DEMO MODE" banner. Never enable it for a real deployment.
# VITE_DEMO_MODE=true
