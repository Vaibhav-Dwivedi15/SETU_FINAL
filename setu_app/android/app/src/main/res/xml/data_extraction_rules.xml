<?xml version="1.0" encoding="utf-8"?>
<!-- Block 3: nothing from this app may be cloud-backed-up or device-transferred. The Ed25519
     identity key (Android Keystore-wrapped), the profile, contacts and queued SOS packets are
     device-bound on purpose: a restored copy on another phone would be a second holder of the
     same identity. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
