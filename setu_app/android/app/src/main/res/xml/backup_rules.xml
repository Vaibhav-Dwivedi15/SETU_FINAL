<?xml version="1.0" encoding="utf-8"?>
<!-- Block 3: Android 6-11 (pre-dataExtractionRules) full-backup rules. Belt and braces with
     android:allowBackup="false": exclude every domain. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
