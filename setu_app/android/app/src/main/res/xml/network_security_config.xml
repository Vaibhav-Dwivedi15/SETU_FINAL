<?xml version="1.0" encoding="utf-8"?>
<!-- Block 3: no cleartext HTTP anywhere in the app (the backend is https://). System CAs only;
     user-installed CAs are not trusted for this app. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
