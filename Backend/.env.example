# Copy to .env and fill in real values. NEVER commit the real .env
# (already in .gitignore) -- see project notes on secrets hygiene.

APP_NAME=SETU Backend
APP_VERSION=1.0.0
DEBUG=false

# Postgres connection string. Use the Neon POOLER hostname (not the
# direct endpoint) to stay within the connection ceiling under
# concurrent load -- see project memory on this.
# Format: postgresql+psycopg2://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=

# Responder credential (server-side scripts, and what operators type into the dashboard login).
# >= 32 random chars. NEVER put it in a VITE_ variable or any client bundle.
RESPONDER_API_KEY=

# ADMIN credential: provision/revoke trusted responder signing keys (POST /responders, /revoke).
# Must differ from RESPONDER_API_KEY. Unset => those endpoints answer 503 (fail closed).
ADMIN_API_KEY=

# HMAC key for dashboard session tokens, >= 32 chars. Unset/short => dashboard login answers 503.
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# SESSION_TTL_SECONDS=14400

# --- AI service integration (setu_ai_service) ---
GEMINI_API_KEY=
SETU_AI_GEMINI_ENABLED=false
SETU_AI_EMBEDDING_DEDUP_ENABLED=true

# --- SMS (SMS Gateway for Android, Cloud Server mode, free) ---
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=

# --- CORS ---
# Exact dashboard origin(s), comma separated. '*' is ignored. localhost origins are only added when DEBUG=true.
CORS_ALLOWED_ORIGINS_RAW=https://setu-sih-dashboard.vercel.app

# --- Email / SMTP (email OTP auth -- Phase 5) ---
# Gmail: SMTP_PASSWORD must be a 16-char App Password (requires 2FA on
# the account). The normal account password will be rejected by Google.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SETU

# Number of trusted reverse proxies in front of the app (Render = 1). Used ONLY to
# pick the client IP for rate limiting: the N-th entry from the right of
# X-Forwarded-For. Set 0 if the app is reachable directly (then the header is
# ignored entirely). Verify against your actual deployment before relying on it.
TRUSTED_PROXY_COUNT=1
